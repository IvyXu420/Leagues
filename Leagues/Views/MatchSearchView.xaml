<UserControl x:Class="Leagues.Views.MatchSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:convertor="clr-namespace:Leagues.Convertor"
             xmlns:viewModels="clr-namespace:Leagues.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <convertor:WinLossConverter x:Key="WinLossConverter" />
        <convertor:WinLossColorConverter x:Key="WinLossColorConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150" />   <!-- search box -->
            <RowDefinition Height="*" />      <!-- results list -->
            <RowDefinition Height="Auto" />   <!-- snackbar -->
        </Grid.RowDefinitions>
        <TextBox
            x:Name="InputPlayerName"
            Grid.Row="0"
            Style="{StaticResource MaterialDesignOutlinedTextBox}"
            materialDesign:HintAssist.Hint="Player Name"
            KeyDown="QueryMatch_OnEnterKeyDown"
            HorizontalAlignment="Stretch"
            Height="50" />
        <materialDesign:Snackbar x:Name="Snackbar" Grid.Row="2">
            <materialDesign:Snackbar.MessageQueue>
                <materialDesign:SnackbarMessageQueue />
            </materialDesign:Snackbar.MessageQueue>
        </materialDesign:Snackbar>
        <ListBox x:Name="ResultsList"
                 Grid.Row="1"
                 Margin="0,10,0,0"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 HorizontalContentAlignment="Stretch"
                 Style="{StaticResource MaterialDesignListBox}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type viewModels:MatchSummaryViewModel}">
                    <materialDesign:Card Margin="0,3" Padding="8"
                                         HorizontalAlignment="Stretch"
                                         materialDesign:ElevationAssist.Elevation="Dp1">
                        <DockPanel LastChildFill="False" VerticalAlignment="Center">

                            <materialDesign:Chip Content="{Binding Summary.GameMode}"
                                                 DockPanel.Dock="Right"
                                                 FontSize="11" />

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Summary.Win, Converter={StaticResource WinLossConverter}}"
                                           Foreground="{Binding Summary.Win, Converter={StaticResource WinLossColorConverter}}"
                                           Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                           FontWeight="Bold" Width="40" VerticalAlignment="Center" />

                                <Border Width="40" Height="40" CornerRadius="20" Margin="5,0,5,0">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding ChampionAvatar}" Stretch="UniformToFill" />
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.3" />
                                    </Border.Effect>
                                </Border>

                                <TextBlock Style="{StaticResource MaterialDesignBody1TextBlock}"
                                           VerticalAlignment="Center">
                                    <Run Text="{Binding Summary.Kills, Mode=OneWay}" FontWeight="Bold" />
                                    <Run Text="/" Foreground="Gray" />
                                    <Run Text="{Binding Summary.Deaths, Mode=OneWay}" FontWeight="Bold" />
                                    <Run Text="/" Foreground="Gray" />
                                    <Run Text="{Binding Summary.Assists, Mode=OneWay}" FontWeight="Bold" />
                                </TextBlock>

                                <TextBlock Text="{Binding Summary.PlayedAt, StringFormat='  MM-dd '}"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                                <TextBlock Text="{Binding Summary.Duration, StringFormat=' {0:mm}:{0:ss} '}"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </materialDesign:Card>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>